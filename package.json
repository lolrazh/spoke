{
  "name": "sonic-flow",
  "productName": "Sonic Flow",
  "version": "0.0.1",
  "description": "A Lightweight AI Dictation App for macOS",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "sh -c '(cd worker && npm run dev) & SF_DEVTOOLS=1 electron-forge start'",
    "dev:ws": "npm run dev --prefix worker",
    "start": "electron-forge start",
    "package": "electron-forge package --arch=arm64",
    "make": "electron-forge make --arch=arm64",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "clean": "rimraf out",
    "postinstall": "bash native/build-helper.sh"
  },
  "keywords": [],
