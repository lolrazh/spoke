{
  "name": "spoke",
  "productName": "Spoke",
  "version": "0.4.0",
  "description": "Voice-to-text AI that works everywhere you do",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "SF_DEVTOOLS=1 electron-forge start",
    "dev:onboarding": "SF_DEVTOOLS=1 FORCE_ONBOARDING=1 electron-forge start",
    "dev:onboarding:skip-auth": "SF_DEVTOOLS=1 FORCE_ONBOARDING=1 SKIP_AUTH=1 electron-forge start",
    "dev:ws": "npm run dev --prefix worker",
    "dev:local": "SF_DEVTOOLS=1 VITE_TRANSCRIBE_WS_URL=ws://127.0.0.1:8787/ws electron-forge start",
    "dev:prod": "SF_DEVTOOLS=1 VITE_TRANSCRIBE_WS_URL=wss://api.spoke.so/ws electron-forge start",
    "start": "electron-forge start",
    "package": "electron-forge package --arch=arm64",
    "package:env": "dotenv -e .env -- electron-forge package --arch=arm64",
    "make": "electron-forge make --arch=arm64",
    "make:env": "dotenv -e .env -- electron-forge make --arch=arm64",
    "stage:local:package": "dotenv -e .env -- bash -lc \"VITE_SF_DEVTOOLS=1 VITE_ALLOW_DEV_WS=1 VITE_TRANSCRIBE_WS_URL=ws://127.0.0.1:8787/ws VITE_SENTRY_ENVIRONMENT=staging electron-forge package --arch=arm64\"",
    "stage:prod:package": "dotenv -e .env -- bash -lc \"VITE_SF_DEVTOOLS=1 VITE_TRANSCRIBE_WS_URL=wss://api.spoke.so/ws VITE_SENTRY_ENVIRONMENT=staging electron-forge package --arch=arm64\"",
    "stage:local:make": "dotenv -e .env -- bash -lc \"VITE_SF_DEVTOOLS=1 VITE_ALLOW_DEV_WS=1 VITE_TRANSCRIBE_WS_URL=ws://127.0.0.1:8787/ws VITE_SENTRY_ENVIRONMENT=staging electron-forge make --arch=arm64\"",
    "stage:prod:make": "dotenv -e .env -- bash -lc \"VITE_SF_DEVTOOLS=1 VITE_TRANSCRIBE_WS_URL=wss://api.spoke.so/ws VITE_SENTRY_ENVIRONMENT=staging electron-forge make --arch=arm64\"",
    "publish": "electron-forge publish",
    "publish:env": "dotenv -e .env -- electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "clean": "rimraf out",
    "postinstall": "bash native/build-helper.sh",
    "kill:port:8787": "node scripts/kill-port.js 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": {
    "name": "Sandheep Rajkumar",
    "email": "sandy@spoke.so"
  },
  "license": "Proprietary",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/core": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.7.0",
    "@electron-forge/plugin-fuses": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@electron-forge/publisher-s3": "^7.8.1",
    "@electron-forge/shared-types": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@electron/osx-sign": "^2.0.0",
    "@types/react": "^18.0.38",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "dotenv-cli": "^7.4.1",
    "electron": "35.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "execa": "^9.6.0",
    "happy-dom": "^18.0.1",
    "postcss": "^8.4.31",
    "prettier": "3.6.1",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.3.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.31.0"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@ricky0123/vad-web": "^0.0.26",
    "@sentry/electron": "^6.11.0",
    "@sentry/vite-plugin": "^4.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "@vitejs/plugin-react": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "framer-motion": "^12.23.5",
    "lucide-react": "^0.525.0",
    "onnxruntime-web": "^1.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "update-electron-app": "^3.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
