{
  "name": "spoke",
  "productName": "Spoke",
  "version": "0.1.29",
  "description": "Voice-to-text AI that works everywhere you do",
  "main": ".vite/build/main.js",
  "scripts": {
    "predev": "node scripts/ensure-local-stt-runtime.mjs --optional",
    "dev": "SF_DEVTOOLS=1 electron-forge start",
    "predev:onboarding": "node scripts/ensure-local-stt-runtime.mjs --optional",
    "dev:onboarding": "SF_DEVTOOLS=1 FORCE_ONBOARDING=1 electron-forge start",
    "prestart": "node scripts/ensure-local-stt-runtime.mjs --optional",
    "start": "electron-forge start",
    "package": "electron-forge package --arch=arm64",
    "package:env": "node --env-file=.env scripts/run-command.mjs electron-forge package --arch=arm64",
    "make": "electron-forge make --arch=arm64",
    "make:env": "node --env-file=.env scripts/run-command.mjs electron-forge make --arch=arm64",
    "stage:package": "VITE_SF_DEVTOOLS=1 node --env-file=.env scripts/run-command.mjs electron-forge package --arch=arm64",
    "stage:make": "VITE_SF_DEVTOOLS=1 node --env-file=.env scripts/run-command.mjs electron-forge make --arch=arm64",
    "release:preflight": "node --env-file=.env scripts/run-command.mjs bash scripts/release-preflight.sh",
    "publish": "electron-forge publish",
    "publish:env": "node --env-file=.env scripts/run-command.mjs electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "clean": "node scripts/clean.mjs",
    "postinstall": "bash native/build-helper.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:stt": "node scripts/ensure-local-stt-runtime.mjs",
    "benchmark:stt": "local-stt/.venv/bin/python local-stt/benchmark.py",
    "benchmark:stt:suite": "local-stt/.venv/bin/python local-stt/benchmark_suite.py"
  },
  "keywords": [],
  "author": {
    "name": "Sandheep Rajkumar",
    "email": "sandy@spoke.so"
  },
  "license": "Proprietary",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-dmg": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.7.0",
    "@electron-forge/plugin-vite": "^7.7.0",
    "@electron-forge/publisher-github": "^7.8.1",
    "@electron-forge/shared-types": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.38",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.16",
    "double-metaphone": "^2.0.1",
    "electron": "^35.7.5",
    "electron-updater": "^6.8.9",
    "eslint": "^8.57.1",
    "fastest-levenshtein": "^1.0.16",
    "framer-motion": "^12.23.5",
    "happy-dom": "^20.0.11",
    "postcss": "^8.4.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "subtlex-word-frequencies": "^2.0.0",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.6.3",
    "vite": "^6.2.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "npm@10.9.8"
}
