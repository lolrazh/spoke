    },
    skipTaskbar: true,
    show: false,
    alwaysOnTop: true,
    backgroundColor: '#00000000',
    hasShadow: true
  });
  
  // HTML for key capture UI - simplified to match native context menu
  const captureHtml = `
    <html>
    <head>
      <style>
        html, body {
          margin: 0;
          padding: 0;
          background-color: transparent;
          overflow: hidden;
        }
        
        body {
