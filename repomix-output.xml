          border-radius: 6px; /* Increased from 3px to 6px for more rounded corners */
          text-align: center;
          width: 170px; /* Reduced width */
          min-height: 18px;
        }
        
        .key-display.listening {
          border: 1px solid #555555;
        }
        
        .hint {
          font-size: 11px;
          color: #aaaaaa;
          margin-top: 3px;
          text-align: center;
        }
        
        .buttons {
          display: flex;
          justify-content: flex-end;
          margin-top: 4px;
          margin-bottom: 2px;
        }
        
        button {
          background-color: transparent;
