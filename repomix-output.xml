        {/* Main content area */}
        <main className="flex-1 p-4 overflow-y-auto bg-sonic-darker">
          <motion.div
            key={activeTab}
            initial="hidden"
            animate="visible"
            variants={containerVariants}
            className="max-w-4xl mx-auto"
