###############################
# Sonic Flow — Publish Config #
###############################

# Cloudflare R2 credentials (S3-compatible)
# Create an R2 API Token with permissions to write objects to your bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# R2 endpoint (no trailing slash). Replace <ACCOUNT_ID> with your account ID.
# Example: https://aaaaaaaaaaaaaaa.r2.cloudflarestorage.com
R2_ENDPOINT=

# R2 bucket name used for releases
R2_BUCKET=releases

# R2 region (use "auto" for R2)
R2_REGION=auto

# Notes:
# - Do NOT commit a real .env. Copy this file to .env and fill values locally.
# - Ensure your R2 bucket or route is publicly readable via R2 settings/policy
#   and mapped to your custom domain (e.g., https://releases.sonicflow.app).

