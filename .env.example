# Apple signing (local CI-style)
# Use Developer ID to ship externally: e.g., "Developer ID Application: Your Name (TEAMID)"
APPLE_IDENTITY=
# Optional: override Apple Development identity (fallback used if empty)
APPLE_DEV_IDENTITY=
# Notarization (enable by providing all three)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# Explicit notarization toggle (overrides auto-detect)
# APPLE_NOTARIZE=0  # disable
# APPLE_NOTARIZE=1  # enable
APPLE_NOTARIZE=
