<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs these for the Hardened Runtime -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key><true/>

  <!-- Allow recording audio under the Hardened Runtime -->
  <key>com.apple.security.device.audio-input</key><true/>

  <!-- Only add this if you load unsigned third‑party native modules -->
  <!-- <key>com.apple.security.cs.disable-library-validation</key><true/> -->

  <!-- Helper processes usually don't need device-specific entitlements -->
</dict>
</plist> 